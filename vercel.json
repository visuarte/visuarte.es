{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/cine", "destination": "/audiovisual", "permanent": true },
    { "source": "/legal/privacidad-app", "destination": "/legal/privacidad", "permanent": true },
    { "source": "/trabajo/imprenta-rotulacion", "destination": "/rotulacion", "permanent": true },
    { "source": "/trabajo/bolco-vision", "destination": "/estudio", "permanent": true },
    { "source": "/trabajo/academia-ia-mapicp", "destination": "/estudio", "permanent": true },
    { "source": "/trabajo/qrcard-online", "destination": "/trabajo", "permanent": true },
    { "source": "/trabajo/camiart", "destination": "/trabajo", "permanent": true },
    { "source": "/proyecto/:id", "destination": "/trabajo", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Powered-By",
          "value": "MAPICP CORE"
        }
      ]
    }
  ]
}
