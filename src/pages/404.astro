---
import Layout from '../layouts/Layout.astro';
---
<Layout
  titulo="Esta página no existe — VISUARTE"
  descripcion="La página que buscas no existe o ha cambiado de sitio."
>
  <section class="wrap hero">
    <p class="eyebrow">Error 404</p>
    <h1 class="display hero-title">Esta página no existe <em>(o ya no).</em></h1>
    <p class="lede hero-lede">
      El enlace que has seguido no lleva a ninguna parte. Puede que se haya movido o que nunca
      existiera.
    </p>
    <div class="hero-meta">
      <a href="/" class="btn">Volver al inicio</a>
      <a href="/trabajo" class="btn btn-ghost">Ver el trabajo</a>
    </div>
  </section>
</Layout>
