---
// HOME — estructura de conversión del plan de Iván, copy de la casa (24 oct 2026).
// CTA dual, tira de confianza, cuatro territorios, presupuesto rápido, reseñas, FAQ.
import Layout from '../layouts/Layout.astro';
import Icono from '../components/Icono.astro';
import { contacto, territorios, confianzaGrupos, serviciosPresupuesto, faq, resenas, resenasUrl } from '../data/site';
---

<Layout
  titulo="VISUARTE — Pensado a lo grande. Fabricado de verdad."
  descripcion="Estudio de diseño e imprenta en Alicante, Vega Baja y Murcia: marca, rotulación de fachadas y vehículos, audiovisual, web y software, y gestión de procesos con IA. Del primer boceto al último acabado."
  precarga="/hero/hero-1600.webp"
  precargaSrcset="/hero/hero-900.webp 900w, /hero/hero-1600.webp 1600w"
>
  <!-- HERO: claim de la casa + CTA dual (pedir presupuesto / WhatsApp)
       Fondo a sangre (imagen generada en local con BOLCO VISION, 24 oct 2026):
       la imagen ES la página — sin panel ni borde. El velo deja el texto sobre negro puro. -->
  <section class="hero hero--encender">
    <div class="hero-bg" aria-hidden="true">
      <img
        src="/hero/hero-1600.webp"
        srcset="/hero/hero-900.webp 900w, /hero/hero-1600.webp 1600w"
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-velo"></div>
    </div>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Marca · espacio · digital · automatización</p>
          <h1 class="display hero-title">
            {contacto.claim}<br /><em>{contacto.claimEm}</em>
          </h1>
          <p class="lede hero-lede">{contacto.lede}</p>
          <div class="hero-meta">
            <a href="#presupuesto" class="btn">Pedir presupuesto</a>
            <a
              href={`https://wa.me/${contacto.telefonoIntl}?text=Hola%20VISUARTE%2C%20quiero%20un%20presupuesto`}
              class="btn btn-ghost"
              rel="noopener"
              >Hablar por WhatsApp</a
            >
          </div>
          <p class="hero-nota">{contacto.cobertura} · Sede en {contacto.sede}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIRA DE CONFIANZA: marcas/clientes, productoras (promo) y videoclips -->
  <section class="wrap confianza" aria-label="Marcas, productoras y videoclips">
    {confianzaGrupos.map((g) => (
      <div class="confianza-grupo">
        <p class="confianza-intro">{g.etiqueta}</p>
        <ul class="confianza-lista">
          {g.items.map((m) => (
            <li data-tipo={m.tipo}>
              {m.logo ? (
                <img
                  src={m.logo}
                  alt={m.nombre}
                  style={`height:${Math.round(26 * (m.escala ?? 1))}px`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                m.nombre
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <hr class="rule" />

  <!-- LOS CUATRO TERRITORIOS (nuestro marco; no una lista de diez servicios) -->
  <section class="wrap section">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.8rem">Los cuatro territorios</h2>
      <span class="sec-num">01 — MARCA · ESPACIO · DIGITAL · AUTOMATIZACIÓN</span>
    </div>
    <div class="servicios">
      {territorios.map((t) => (
        <article class="servicio">
          <div class="servicio-cab">
            <Icono nombre={t.icono} size={22} />
            <h3><a href={t.href}>{t.nombre}</a></h3>
            <span class="servicio-num">{t.numero}</span>
          </div>
          <p>{t.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- PRESUPUESTO RÁPIDO: el formulario corto del plan de Iván -->
  <section class="wrap section" id="presupuesto">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.8rem">¿Tienes un proyecto en mente?</h2>
      <span class="sec-num">02 — PRESUPUESTO SIN COMPROMISO</span>
    </div>
    <!-- SIN SERVIDOR: el formulario compone un correo en la app del visitante (mailto).
         Antes apuntaba a /api/presupuesto, una ruta que no existe: un envío daba 404.
         No se guarda nada en ningún servidor nuestro. -->
    <form
      class="presupuesto"
      method="post"
      action={`mailto:${contacto.email}`}
      enctype="text/plain"
    >
      <div class="campo">
        <label for="nombre">Tu nombre</label>
        <input id="nombre" name="nombre" type="text" autocomplete="name" required />
      </div>
      <div class="campo">
        <label for="telefono">Teléfono</label>
        <input id="telefono" name="telefono" type="tel" autocomplete="tel" required />
      </div>
      <div class="campo">
        <label for="servicio">Qué necesitas</label>
        <select id="servicio" name="servicio">
          {serviciosPresupuesto.map((s) => <option>{s}</option>)}
        </select>
      </div>
      <div class="campo campo-ancho">
        <label for="mensaje">Cuéntalo en dos líneas (opcional)</label>
        <textarea id="mensaje" name="mensaje" rows="3"></textarea>
      </div>
      <div class="campo campo-ancho">
        <button class="btn" type="submit">Enviar y que me llamen</button>
        <p class="nota">
          Al enviar se abre tu aplicación de correo con estos datos: el mensaje sale de tu cuenta y
          no se guarda en ningún servidor de la web. Respuesta en menos de 24 h laborables. Si el
          trabajo necesita inspección, se dice antes de dar precio firme. ¿Prefieres hablar?{' '}
          <a href={`https://wa.me/${contacto.telefonoIntl}`} rel="noopener">WhatsApp</a>.
        </p>
      </div>
    </form>
  </section>

  <!-- RESEÑAS REALES: copiadas de Google, con nombre y fecha, y enlace al perfil
       para leerlas TODAS (también la de 1★). No se filtra ni se inventa. -->
  <section class="wrap section-tight">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.5rem">Opiniones de clientes</h2>
      <span class="sec-num">03 — DE GOOGLE, SIN RETOCAR</span>
    </div>
    <div class="resenas">
      {resenas.map((r) => (
        <figure class="resena">
          <div class="resena-estrellas" aria-label={`${r.estrellas} de 5`}>
            <span aria-hidden="true">{'★'.repeat(r.estrellas)}</span>
          </div>
          <blockquote>{r.texto}</blockquote>
          <figcaption>
            <strong>{r.nombre}</strong>
            <a class="resena-fuente" href={resenasUrl} target="_blank" rel="noopener">
              Google · {r.cuando} ↗
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- FAQ: responde lo que frena la llamada -->
  <section class="wrap section-tight">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.5rem">Preguntas frecuentes</h2>
      <span class="sec-num">04 — ANTES DE ESCRIBIR</span>
    </div>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>{f.p}</summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </section>
  <!-- CIERRE: el claim de cierre, la promesa en una línea (24 oct 2026) -->
  <section class="wrap section-tight cierre">
    <p class="eyebrow">En una línea</p>
    <p class="display cierre-claim">{contacto.cierre}</p>
    <div class="hero-meta">
      <a href="#presupuesto" class="btn">Pedir presupuesto</a>
      <a
        href={`https://wa.me/${contacto.telefonoIntl}?text=Hola%20VISUARTE%2C%20quiero%20un%20presupuesto`}
        class="btn btn-ghost"
        rel="noopener">Hablar por WhatsApp</a
      >
    </div>
  </section>

</Layout>
