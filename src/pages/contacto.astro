---
// CONTACTO (24 oct 2026) — sin formulario muerto: canales reales y qué mandar.
// El formulario de la portada compone el mensaje y abre WhatsApp: no se guarda nada en servidor.
import Layout from '../layouts/Layout.astro';
import { contacto } from '../data/site';

const wa = `https://wa.me/${contacto.telefonoIntl}?text=${encodeURIComponent(
  'Hola VISUARTE, quiero un presupuesto'
)}`;
// La dirección va en texto, no en imagen: es lo que Google lee para el SEO local.
const comoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${contacto.calle}, ${contacto.cp} ${contacto.localidad}, ${contacto.provincia}`
)}`;
---

<Layout
  titulo="Contacto — VISUARTE Studio · Ciudad Quesada (Rojales)"
  descripcion="WhatsApp, teléfono o correo. Taller en Ciudad Quesada (Rojales); cobertura en Alicante, Vega Baja y Murcia. Se contesta con una estimación, sin compromiso."
  precarga="/hero/contacto-1600.webp"
  precargaSrcset="/hero/contacto-900.webp 900w, /hero/contacto-1600.webp 1600w"
>
  <!-- HERO (24 oct 2026): el guiño clásico, pero en material. Una carta doblada
       con su sello de lacre, en macro y con la misma luz cálida que las otras
       páginas. No es un sobre de icono: es cera, papel y una sombra. Y el sello
       no es adorno — en esta casa lo que se entrega se firma. Generada en local
       con BOLCO VISION/FLUX; el encendido es un filtro CSS, cero JavaScript. -->
  <section class="hero hero--encender">
    <div class="hero-bg" aria-hidden="true">
      <img
        src="/hero/contacto-1600.webp"
        srcset="/hero/contacto-900.webp 900w, /hero/contacto-1600.webp 1600w"
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-velo"></div>
    </div>
    <div class="wrap">
    <div>
      <p class="eyebrow">Contacto</p>
      <h1 class="display hero-title">Hablemos.</h1>
      <p class="lede hero-lede">
        Escríbenos con lo que tengas: una foto, unas medidas a ojo o solo la idea. Primero se habla,
        después se mide —y si hace falta ver el sitio, se dice <strong>antes</strong> de dar precio
        firme.
      </p>
      <div class="hero-meta">
        <a class="btn" href={wa} rel="noopener">Hablar por WhatsApp</a>
        <a class="btn btn-ghost" href={`tel:+${contacto.telefonoIntl}`}>Llamar</a>
      </div>
      <p class="hero-nota">Taller en {contacto.sede} · {contacto.cobertura}</p>
    </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- CANALES -->
  <section class="wrap section-tight">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.5rem">Por dónde pillarnos</h2>
      <span class="sec-num">01 — SIN INTERMEDIARIOS</span>
    </div>
    <div class="contacto-grid">
      <div class="contacto-card">
        <span class="clave">WhatsApp y teléfono</span>
        <a class="valor" href={`tel:+${contacto.telefonoIntl}`}>{contacto.telefono}</a>
        <p class="nota">Lo más rápido: manda la foto del sitio y las medidas.</p>
        <a class="enlace-mono" href={wa} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path
              d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.48-8.41Z"
            ></path>
          </svg>
          Abrir WhatsApp
        </a>
      </div>
      <div class="contacto-card">
        <span class="clave">Correo</span>
        <a class="valor" href={`mailto:${contacto.email}`}>{contacto.email}</a>
        <p class="nota">Para archivos, planos y presupuestos con detalle.</p>
      </div>
      <div class="contacto-card">
        <span class="clave">Taller</span>
        <span class="valor valor--dir">
          <span>{contacto.calle}</span>
          <span>{contacto.cp} {contacto.localidad}</span>
        </span>
        <p class="nota">Visitas con cita previa: no se atiende a quien llega sin avisar.</p>
        <a class="enlace-mono" href={comoLlegar} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path
              fill-rule="evenodd"
              d="M12 22s7-5.8 7-11.5a7 7 0 1 0-14 0C5 16.2 12 22 12 22Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
            ></path>
          </svg>
          Cómo llegar
        </a>
      </div>
    </div>
  </section>

  <!-- QUÉ CONTAR -->
  <section class="wrap section-tight">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.5rem">Qué viene bien para empezar</h2>
      <span class="sec-num">02 — CON ESTO SE PUEDE DAR PRECIO</span>
    </div>
    <div class="dos-columnas">
      <div>
        <p class="mono-etiqueta">Cuéntanos</p>
        <ul class="lista-marcada">
          <li>Qué es la pieza y para qué se usa</li>
          <li>Dónde va: pared, chapa, cristal, carrocería o pantalla</li>
          <li>Medidas, aunque sean a ojo</li>
          <li>Una foto del sitio tal y como está hoy</li>
          <li>Para cuándo lo necesitas</li>
        </ul>
      </div>
      <div>
        <p class="mono-etiqueta">Y si aún no lo tienes</p>
        <ul class="lista-marcada">
          <li>Escribe igual: el proyecto se puede pensar juntos</li>
          <li>Si hay que medir, se va al sitio antes de presupuestar</li>
          <li>Si la idea no es viable, se dice antes de cobrar nada</li>
          <li>Nada de presupuestos de tres páginas para una lona</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRIVACIDAD, EN CORTO -->
  <section class="wrap section-tight">
    <div class="sec-head">
      <h2 class="display" style="font-size:1.5rem">Qué pasa con tus datos</h2>
      <span class="sec-num">03 — EN CORTO Y EN CLARO</span>
    </div>
    <p class="prose" style="max-width:none">
      Esta web no tiene formularios que guarden nada en un servidor, ni analítica, ni cookies
      publicitarias. Si nos escribes por WhatsApp o por correo, tus datos se usan para responderte y
      para el trabajo, y nada más. El detalle completo está en la
      <a href="/legal/privacidad">política de privacidad</a>.
    </p>
    <div class="hero-meta">
      <a class="btn" href={wa} rel="noopener">Hablar por WhatsApp</a>
      <a class="btn btn-ghost" href={`tel:+${contacto.telefonoIntl}`}>Llamar</a>
    </div>
  </section>
</Layout>
