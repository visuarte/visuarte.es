---
// LIGHTBOX DE OBRA — la pieza en pequeño, la ficha en grande (24 oct 2026).
//
// Sin una línea de JavaScript: se abre con :target (#id) y se cierra con el
// enlace de cierre (vuelve a #obra) o con el botón atrás del navegador. En la
// casa el cero JavaScript no es un adorno de la ficha de /trabajo: es la regla.
//
// Dos formas de usarlo:
//   mini (por defecto) — pinta la miniatura gris que se enciende al pasar por
//     encima y abre la ficha. Es lo que usa /rotulacion.
//   mini={false} — pinta SOLO la ficha; la miniatura la pone la página (así la
//     vitrina conserva su tarjeta con número, cliente y año, y el disparo es
//     la propia imagen).
interface Soportes {
  src: string;
  alt: string;
  pie: string;
}
interface Props {
  /** Ancla de la ficha. Tiene que ser única en la página. */
  id: string;
  src: string;
  srcset?: string;
  width: number;
  height: number;
  alt: string;
  /** Pie corto: cliente, qué es y año. */
  cliente: string;
  tipo: string;
  anio: string;
  /** false = la página pone su propia miniatura (vitrina). */
  mini?: boolean;
  /** Las otras caras del trabajo: soportes, aplicaciones, piezas del sistema. */
  soportes?: Soportes[];
  /** A dónde vuelve el botón de cerrar. Por defecto #obra. */
  cerrarA?: string;
}
const {
  id, src, srcset, width, height, alt, cliente, tipo, anio,
  mini = true, soportes = [], cerrarA = '#obra',
} = Astro.props;
// El mini pide la variante pequeña; si no hay srcset, se sirve la misma.
const miniSrc = srcset ? srcset.split(',')[0].trim().split(/\s+/)[0] : src;
---

{mini && (
  <figure class="obra-mini">
    <a class="obra-mini-disparo" href={`#${id}`}>
      <img
        src={miniSrc}
        srcset={srcset}
        sizes="320px"
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    </a>
    <figcaption class="obra-mini-pie">
      <strong>{cliente}</strong>
      <span>{tipo} · {anio}</span>
    </figcaption>
  </figure>
)}

<div class="lightbox" id={id} role="group" aria-labelledby={`${id}-titulo`}>
  <a class="lightbox-fondo" href={cerrarA} aria-label="Cerrar la ficha"></a>
  <figure class="lightbox-ficha">
    <div class="lightbox-media">
      <img src={src} srcset={srcset} sizes="(min-width: 900px) 520px, 92vw" alt={alt} width={width} height={height} decoding="async" />
      {soportes.length > 0 && (
        <div class="lightbox-soportes">
          {soportes.map((s) => (
            <figure>
              <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              <figcaption>{s.pie}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
    <figcaption>
      <p class="lightbox-eyebrow">{tipo} · {anio}</p>
      <h3 id={`${id}-titulo`}>{cliente}</h3>
      <slot />
    </figcaption>
  </figure>
  <!-- El cierre vive fuera de la ficha y pegado a la esquina: si la ficha es
       larga (con soportes) y hay que rodar dentro, el botón sigue a la vista. -->
  <a class="lightbox-cerrar-fijo" href={cerrarA}>Cerrar ×</a>
</div>
