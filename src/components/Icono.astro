---
// Los cuatro iconos de territorio, inline y sin JavaScript (24 oct 2026).
// Mismo dibujo que la versión React; aquí se resuelve en el build.
interface Props {
  nombre: 'marca' | 'espacio' | 'digital' | 'automatizacion';
  size?: number;
}
const { nombre, size = 26 } = Astro.props;
const trazo = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  focusable: 'false',
};
---

<span class="servicio-icono" style={`width:${size}px;height:${size}px`}>
  {nombre === 'marca' && (
    <svg {...trazo}>
      <path d="M12 2.5 21.5 9 12 21.5 2.5 9Z" />
      <path d="M2.5 9h19M12 2.5 8.5 9l3.5 12.5L15.5 9Z" />
    </svg>
  )}
  {nombre === 'espacio' && (
    <svg {...trazo}>
      <rect x="2.5" y="5" width="19" height="15" rx="1.5" />
      <path d="M2.5 9.5h19" />
      <path d="M5.5 7.2h4" />
      <path d="M9.5 20v-5.5h5V20" />
    </svg>
  )}
  {nombre === 'digital' && (
    <svg {...trazo}>
      <rect x="2.5" y="4" width="19" height="16" rx="2" />
      <path d="M2.5 8h19" />
      <path d="m9.5 12-2 2.2 2 2.2M14.5 12l2 2.2-2 2.2" />
    </svg>
  )}
  {nombre === 'automatizacion' && (
    <svg {...trazo}>
      <circle cx="12" cy="12" r="3.6" />
      <path d="M17.4 12h1.6M15.8 15.8l1.15 1.15M12 17.4v1.6M8.2 15.8 7.05 16.95M6.6 12H5M8.2 8.2 7.05 7.05M12 6.6V5M15.8 8.2l1.15-1.15" />
    </svg>
  )}
</span>
