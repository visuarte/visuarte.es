---
// LAYOUT DE LA CASA — Astro (24 oct 2026). Sin framework en el cliente: esto se genera en build.
import '../styles/fonts.css';
import '../styles/design-tokens.css';
import '../styles/base.css';
import '../styles/pages.css';
import '../styles/web2.css';
import { nav, contacto } from '../data/site';

interface Props {
  titulo: string;
  descripcion: string;
  /** Imagen crítica del LCP (solo la portada la usa): se precarga con prioridad alta. */
  precarga?: string;
  precargaSrcset?: string;
}
const { titulo, descripcion, precarga, precargaSrcset } = Astro.props;
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es" data-mood="llama">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {precarga && (
      <link
        rel="preload"
        as="image"
        href={precarga}
        imagesrcset={precargaSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/logo/llama-2t.svg" />
    <meta name="theme-color" content="#151513" />
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <title>{titulo}</title>
    <!-- Poppins se sirve desde /fonts (propia): cero peticiones a terceros. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/poppins-700.woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand-link" aria-label="VISUARTE — inicio">
          <img class="brand-mark" src="/logo/imagotipo-visuarte.png" alt="" width="28" height="28" />
          <span class="brand-txt">VISUARTE<span class="brand-txt-sub"> STUDIO</span></span>
        </a>
        <nav class="main-nav" aria-label="Principal">
          {nav.map((item) => (
            <a
              href={item.path}
              aria-current={Astro.url.pathname.startsWith(item.path) ? 'page' : undefined}
            >
              {item.nombre}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="footer-word">{contacto.marca}</span>
        <span class="footer-word">© {anio} — Estudio de diseño, imprenta y producción.</span>
        <span class="footer-word">
          {contacto.titular} · NIF {contacto.nif} · {contacto.sede} · {contacto.cobertura}
        </span>
        <span class="footer-word">
          <a class="footer-legal" href="/legal/aviso">Aviso legal</a>
          {' · '}
          <a class="footer-legal" href="/legal/privacidad">Privacidad</a>
        </span>
      </div>
    </footer>
  </body>
</html>
