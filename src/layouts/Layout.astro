---
// LAYOUT DE LA CASA — Astro (24 oct 2026). Sin framework en el cliente: esto se genera en build.
import '../styles/fonts.css';
import '../styles/design-tokens.css';
import '../styles/base.css';
import '../styles/pages.css';
import '../styles/web2.css';
import Analytics from '@vercel/analytics/astro';
import { nav, contacto, resenasUrl } from '../data/site';

interface Props {
  titulo: string;
  descripcion: string;
  /** Imagen crítica del LCP (solo la portada la usa): se precarga con prioridad alta. */
  precarga?: string;
  precargaSrcset?: string;
}
const { titulo, descripcion, precarga, precargaSrcset } = Astro.props;
// Dominio canónico y URL de esta página, para og:url y canonical.
const sitio = 'https://visuarte.es';
const canonica = new URL(Astro.url.pathname.replace(/\/index\.html$/, '/'), sitio).href;
const anio = new Date().getFullYear();

// DATOS ESTRUCTURADOS DEL ESTUDIO (4 nov 2026). El README decía «JSON-LD» y no había
// ninguno: esto lo pone de verdad. La dirección es la del TALLER, no la fiscal (esa
// solo vive en el aviso legal). El enlace es la ficha real, por CID.
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${sitio}/#estudio`,
  name: 'VISUARTE Studio',
  // Descripción fija del negocio (no la de la página: el LocalBusiness es el mismo en toda la web).
  description:
    'Estudio de diseño, rotulación e imprenta en Ciudad Quesada (Rojales), Alicante. Marca, fachadas, vehículos, gran formato, web y audiovisual, con taller propio.',
  url: sitio,
  telephone: `+${contacto.telefonoIntl}`,
  email: contacto.email,
  image: `${sitio}/og-image.jpg`,
  logo: `${sitio}/logo/imagotipo-visuarte.png`,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacto.calle,
    postalCode: contacto.cp,
    addressLocality: contacto.localidad,
    addressRegion: contacto.provincia,
    addressCountry: 'ES',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Vega Baja' },
    { '@type': 'AdministrativeArea', name: 'Alicante' },
    { '@type': 'AdministrativeArea', name: 'Murcia' },
  ],
  sameAs: [resenasUrl],
};
---

<!doctype html>
<html lang="es" data-mood="llama">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {precarga && (
      <link
        rel="preload"
        as="image"
        href={precarga}
        imagesrcset={precargaSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/logo/llama-2t.svg" />
    <meta name="theme-color" content="#151513" />
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VISUARTE Studio" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonica} />
    <!-- La tarjeta de enlace: sin esto, pegar visuarte.es en WhatsApp o Telegram
         salía sin imagen — un escaparate con la persiana a medio bajar.
         1200x630, el claim de la casa y los filamentos del hero (24 oct 2026). -->
    <meta property="og:image" content={`${sitio}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VISUARTE Studio — Pensado a lo grande. Fabricado de verdad." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonica} />
    <title>{titulo}</title>
    <!-- Poppins se sirve desde /fonts (propia): cero peticiones a terceros. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/poppins-700.woff2" crossorigin />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(negocio)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand-link" aria-label="VISUARTE STUDIO — inicio">
          <img class="brand-mark" src="/logo/imagotipo-visuarte.png" alt="" width="28" height="28" />
          <span class="brand-txt">VISUARTE<span class="brand-txt-sub"> STUDIO</span></span>
        </a>
        <nav class="main-nav" aria-label="Principal">
          {nav.map((item) => (
            <a
              href={item.path}
              aria-current={Astro.url.pathname.startsWith(item.path) ? 'page' : undefined}
            >
              {item.nombre}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="footer-word">{contacto.marca}</span>
        <span class="footer-word">© {anio} — Estudio de diseño, imprenta y producción.</span>
        <!-- Nombre y NIF fuera del pie (4 nov 2026, consejo de Manuel): la LSSI ya
             los tiene en el aviso legal, que se enlaza desde aquí en todas las
             páginas. En el pie solo queda la zona, que sí ayuda al SEO local.
             Ocultarlos con CSS no: o se publican o no se publican. -->
        <span class="footer-word">{contacto.sede} · {contacto.cobertura}</span>
        <span class="footer-word">
          <a class="footer-legal" href="/legal/aviso">Aviso legal</a>
          {' · '}
          <a class="footer-legal" href="/legal/privacidad">Privacidad</a>
        </span>
      </div>
    </footer>

    <!-- MEDICIÓN (4 nov 2026, Diego): Vercel Web Analytics — agregada, sin cookies
         y sin datos personales. Se mide lo único que importa aquí: cuánta gente
         pulsa «pedir presupuesto» y cuánta escribe por WhatsApp, y desde dónde.
         La privacidad lo dice tal cual; no se mide nada más. -->
    <Analytics />
    <script>
      import { track } from '@vercel/analytics';

      // Delegación: sirve para cualquier enlace o formulario que lleve data-evento,
      // en cualquier página, sin repetir el guion.
      document.addEventListener('click', (evento) => {
        const el = (evento.target as HTMLElement)?.closest?.('[data-evento]');
        if (!el) return;
        track(el.getAttribute('data-evento')!, {
          origen: el.getAttribute('data-origen') ?? 'sin-origen',
        });
      });

      document.addEventListener('submit', (evento) => {
        const form = evento.target as HTMLFormElement;
        const nombre = form?.dataset?.evento;
        if (!nombre) return;
        track(nombre, { origen: form.dataset.origen ?? 'sin-origen' });
      });
    </script>
  </body>
</html>
